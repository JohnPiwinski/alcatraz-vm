#!/bin/sh
mount -t proc proc /proc 2>/dev/null || true
mount -t sysfs sysfs /sys 2>/dev/null || true
mount -t devtmpfs devtmpfs /dev 2>/dev/null || true
export HOME=/tmp/vibe-home HOST=127.0.0.1 PORT=3000 BROWSER=none NO_COLOR=1 PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
echo ALCATRAZ_VIBE_INIT_OK
/usr/bin/setpriv --reuid=node --regid=node --init-groups /home/node/vibe-kanban-runtime &
exec /usr/local/bin/vsock-tcp-proxy
