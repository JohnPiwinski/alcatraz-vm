#!/usr/bin/env bash
set -Eeuo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
sock=$(mktemp -u /tmp/alcatraz-vibe-emulator.XXXXXX.sock)
python3 - "$sock" "$root" <<'PY' &
import hashlib, json, os, socket, sys
path, root = sys.argv[1:]
try:
    os.unlink(path)
except FileNotFoundError:
    pass
listener = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
listener.bind(path); listener.listen(3)
ops = {"submit_task": "task", "status_query": "task_id", "operator_review": "reason"}
try:
    for _ in range(3):
        conn, _ = listener.accept()
        with conn:
            assert conn.recv(128) == b"CONNECT 7000\n"
            conn.sendall(b"OK 9000\n")
            raw = b""
            while not raw.endswith(b"\n"):
                raw += conn.recv(4096)
            frame = json.loads(raw)
            assert frame["channel"] == "vibe-to-codex"
            assert frame["operation"] in ops
            assert ops[frame["operation"]] in frame["payload"]
            payload = {"accepted": True, "operation": frame["operation"], "request_id": frame["request_id"]}
            encoded = json.dumps(payload, separators=(",", ":"), sort_keys=True).encode()
            response = {"version": 1, "channel": "codex-to-vibe", "request_id": frame["request_id"],
                        "operation": "result", "nonce": "response-" + frame["nonce"],
                        "payload_sha256": hashlib.sha256(encoded).hexdigest(), "payload": payload}
            conn.sendall(json.dumps(response, separators=(",", ":"), sort_keys=True).encode() + b"\n")
finally:
    listener.close(); os.unlink(path)
PY
server=$!
cleanup() { kill "$server" 2>/dev/null || true; wait "$server" 2>/dev/null || true; rm -f "$sock"; }
trap cleanup EXIT
for _ in $(seq 1 100); do [[ -S "$sock" ]] && break; sleep .05; done
for command in submit-task status operator-review; do
  result=$(cargo run --quiet --manifest-path "$root/Cargo.toml" --bin vibe-codex-emulator -- --socket "$sock" "$command" demo)
  case "$command" in
    submit-task) expected=submit_task ;;
    status) expected=status_query ;;
    operator-review) expected=operator_review ;;
  esac
  jq -e --arg op "$expected" '.accepted == true and .operation == $op' <<<"$result" >/dev/null
done
wait "$server"
echo 'vibe emulator: submit-task, status, and operator-review round trips passed'
